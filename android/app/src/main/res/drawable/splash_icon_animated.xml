<?xml version="1.0" encoding="utf-8"?>
<!-- Launch-screen logo (public/favicon.svg): spins in and settles with a small overshoot.
     Plays on Android 12+; older versions show the final frame. The exit (grow + fade) is in
     MainActivity.fadeOutLogo(). The circle is drawn smaller than the 192dp splash mask so the
     overshoot never gets clipped. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="288dp"
            android:height="288dp"
            android:viewportWidth="288"
            android:viewportHeight="288">
            <group android:name="logo" android:pivotX="144" android:pivotY="144">
                <path
                    android:fillColor="#FACC15"
                    android:pathData="M144,144m-78,0a78,78 0,1 1,156 0a78,78 0,1 1,-156 0" />
                <group android:translateX="144" android:translateY="144">
                    <group android:scaleX="0.138" android:scaleY="-0.138">
                        <group android:translateX="-334" android:translateY="-350">
                            <path android:fillColor="#111111" android:pathData="M46 0V116H138V584H46V700H406Q470 700 517.5 678.5Q565 657 591.5 617.5Q618 578 618 523V513Q618 465 600.0 434.5Q582 404 557.5 387.5Q533 371 511 364V346Q533 340 559.0 323.5Q585 307 603.5 276.0Q622 245 622 195V185Q622 127 595.0 85.5Q568 44 520.5 22.0Q473 0 410 0ZM270 120H394Q437 120 463.5 141.0Q490 162 490 201V211Q490 250 464.0 271.0Q438 292 394 292H270ZM270 412H392Q433 412 459.5 433.0Q486 454 486 491V501Q486 539 460.0 559.5Q434 580 392 580H270Z" />
                        </group>
                    </group>
                </group>
            </group>
        </vector>
    </aapt:attr>

    <target android:name="logo">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator android:propertyName="rotation" android:valueFrom="-360" android:valueTo="0"
                    android:duration="600" android:interpolator="@android:interpolator/fast_out_slow_in" />
                <objectAnimator android:propertyName="scaleX" android:valueFrom="0.2" android:valueTo="1"
                    android:duration="600" android:interpolator="@android:anim/overshoot_interpolator" />
                <objectAnimator android:propertyName="scaleY" android:valueFrom="0.2" android:valueTo="1"
                    android:duration="600" android:interpolator="@android:anim/overshoot_interpolator" />
            </set>
        </aapt:attr>
    </target>
</animated-vector>
